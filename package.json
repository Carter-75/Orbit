{
  "name": "orbit-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "multer": "^2.4.0",
    "stripe": "^22.6.2",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  }
}
